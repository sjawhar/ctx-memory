#!/bin/sh
set -eu

request=$(cat)
if [ -n "${ECHO_REQUEST_OUT-}" ]; then
    printf '%s\n' "$request" > "$ECHO_REQUEST_OUT"
fi

op=$(printf '%s' "$request" | sed -n 's/.*"op":"\([^"]*\)".*/\1/p')
scheme=$(printf '%s' "$request" | sed -n 's/.*"scheme":"\([^"]*\)".*/\1/p' | sed -n '1p')
streams=$(printf '%s' "$request" | sed -n 's/.*"streams":\[\([^]]*\)\].*/\1/p')
window_end=$(printf '%s' "$request" | sed -n 's/.*"window_end":"\([^"]*\)".*/\1/p')
state_dir=$(printf '%s' "$request" | sed -n 's/.*"state_dir":"\([^"]*\)".*/\1/p')

if [ -n "${ECHO_SLEEP-}" ]; then
    sleep "$ECHO_SLEEP"
fi

# With ECHO_WAIT_FOR the source goes on only once that file exists, so a test holds a fetch
# here for as long as it needs, however slow the machine is.
if [ -n "${ECHO_WAIT_FOR-}" ]; then
    while [ ! -e "$ECHO_WAIT_FOR" ]; do
        sleep 0.1
    done
fi

if [ "${ECHO_EXIT-}" = "1" ]; then
    exit 1
fi

if [ "${ECHO_NO_HELLO-}" = "1" ]; then
    exit 0
fi

printf '{"type":"hello","protocol":1,"scheme":"%s","ops":["fetch","resolve"],"verbatim":true,"streams":[%s]}\n' "$scheme" "$streams"

if [ "$op" = "resolve" ]; then
    pointers=$(printf '%s' "$request" | sed -n 's/.*"pointers":\[\([^]]*\)\].*/\1/p' | tr ',' ' ' | tr -d '"')
    for pointer in $pointers; do
        stream=${pointer#*:}
        printf '{"type":"record","pointer":"%s","stream":"%s","ts":"1970-01-01T00:00:00Z","text":"echo %s","raw":null}\n' "$pointer" "$stream" "$pointer"
        if [ "${ECHO_THREAD_SIBLING-}" = "1" ]; then
            printf '{"type":"record","pointer":"%s/sibling","stream":"%s","thread":"%s","ts":"1970-01-01T00:00:01Z","text":"live sibling evidence","raw":null}\n' "$pointer" "$stream" "$pointer"
        fi
    done
    exit 0
fi

record_time=$(date -u -d "$window_end - 1 hour" +%Y-%m-%dT%H:%M:%SZ)
if [ "${ECHO_LATE-}" = "1" ]; then
    record_time=$(date -u -d "$window_end + 1 hour" +%Y-%m-%dT%H:%M:%SZ)
fi

for stream in $(printf '%s' "$streams" | tr ',' ' ' | tr -d '"'); do
    pointer_scheme=$scheme
    if [ "${ECHO_BAD_SCHEME-}" = "1" ]; then
        pointer_scheme=other
    fi
    printf '{"type":"record","pointer":"%s:%s/record","stream":"%s","ts":"%s","text":"echo %s","raw":null}\n' "$pointer_scheme" "$stream" "$stream" "$record_time" "$stream"
    # With ECHO_THREAD_STATE the source behaves like Slack: a reply whose parent is older than
    # the window is reachable only through the file the previous fetch left in state_dir.
    if [ "${ECHO_THREAD_STATE-}" = "1" ]; then
        tracked="$state_dir/threads-$stream.json"
        if [ -f "$tracked" ]; then
            printf '{"type":"record","pointer":"%s:%s/reply","stream":"%s","thread":"%s:%s/record","ts":"%s","text":"echo thread reply","raw":null}\n' "$pointer_scheme" "$stream" "$stream" "$pointer_scheme" "$stream" "$record_time"
        fi
        printf '{"parent":"%s:%s/record"}\n' "$pointer_scheme" "$stream" > "$tracked"
    fi
    if [ "${ECHO_ERROR_CURSOR-}" = "$stream" ]; then
        printf '{"type":"stream_end","stream":"%s","status":"error","cursor":"%s","error":"echo failure"}\n' "$stream" "$window_end"
    elif [ "${ECHO_FAIL_STREAM-}" = "$stream" ]; then
        printf '{"type":"stream_end","stream":"%s","status":"error","error":"echo failure"}\n' "$stream"
    elif [ "${ECHO_NO_END-}" != "$stream" ]; then
        printf '{"type":"stream_end","stream":"%s","status":"ok","cursor":"%s"}\n' "$stream" "$window_end"
        if [ "${ECHO_DUPLICATE_END-}" = "$stream" ]; then
            printf '{"type":"stream_end","stream":"%s","status":"ok","cursor":"%s"}\n' "$stream" "$window_end"
        fi
        if [ "${ECHO_AFTER_END-}" = "$stream" ]; then
            printf '{"type":"record","pointer":"%s:%s/after-end","stream":"%s","ts":"%s","text":"echo after end","raw":null}\n' "$scheme" "$stream" "$stream" "$record_time"
        fi
    fi
done
